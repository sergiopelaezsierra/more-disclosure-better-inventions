# ----------------------------------------------------------------------------
# .gitignore for the replication package.
# Keep large generated artifacts and transient files out of git; they are
# either reproducible from the scripts or distributed separately (e.g. the
# trained SciBERT models, which live on Zenodo).
# ----------------------------------------------------------------------------

# Trained SciBERT classifiers (~1.3 GB). Deposited separately on Zenodo;
# see DATA_AVAILABILITY.md.
trained_models/
Trained models/

# Transient run logs (regenerated by run_all.R; contain absolute paths from
# whoever runs the package locally).
outputs/logs/*
!outputs/logs/.gitkeep

# Generated outputs are reproducible from the scripts. Track the directory
# itself (via .gitkeep) but leave the contents untracked so a fresh clone
# runs cleanly without diff noise.
outputs/figures/*
!outputs/figures/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep

# R session and history files.
.Rhistory
.RData
.Rproj.user/
*.Rproj

# Python caches and Jupyter autosaves.
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.jupyter/

# OS metadata.
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE state.
.vscode/
.idea/

# Virtual environments.
venv/
.venv/
env/

# Restricted-data placeholders (the directory exists so README references
# resolve, but it never contains real data).
data/restricted/*
!data/restricted/.gitkeep
